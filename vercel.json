{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-public.mjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/CRM",
      "destination": "/crm",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/website/index"
    }
  ],
  "rewrites": [
    {
      "source": "/videos/:path*",
      "destination": "/public/videos/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index"
    },
    {
      "source": "/crm",
      "destination": "/index"
    },
    {
      "source": "/crm/:path*",
      "destination": "/index"
    }
  ]
}
