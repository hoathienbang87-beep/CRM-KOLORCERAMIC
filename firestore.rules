rules_version = '2';
// Phase 3 Pro: giữ nền bảo mật Phase 2, bổ sung quản lý user cho admin, audit log và kiểm tra sức khỏe dữ liệu ở client.
// App vẫn dùng soft delete, phoneIndex chống trùng SĐT và auditLogs cho mọi thao tác chính.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function appUser() {
      return get(userPath()).data;
    }

    function activeUser() {
      return hasUserDoc() && (
        appUser().active == true ||
        appUser().active == 'true' ||
        appUser().status == 'active' ||
        appUser().status == 'Active' ||
        appUser().status == 'ACTIVE'
      );
    }

    function role() {
      return appUser().role;
    }

    function isAdmin() {
      return activeUser() && role() in [
        'admin', 'Admin', 'ADMIN',
        'quantri', 'quản trị', 'Quản trị', 'Quản Trị'
      ];
    }

    // Firestore Rules phân biệt hoa/thường và dấu tiếng Việt.
    // Vì dữ liệu role trong users có thể nhập nhiều kiểu, phần này chấp nhận các biến thể phổ biến.
    function isManager() {
      return activeUser() && role() in [
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'quanly', 'Quanly', 'QUANLY',
        'ql', 'QL',
        'quản lý', 'Quản lý', 'Quản Lý',
        'quản lí', 'Quản lí', 'Quản Lí',
        'quan ly', 'Quan ly', 'Quan Ly',
        'quan li', 'Quan li', 'Quan Li'
      ];
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function ownerName() {
      return appUser().name;
    }

    function isMyData(data) {
      return activeUser() && (
        data.ownerEmail == myEmail() ||
        data.createdByEmail == myEmail() ||
        data.owner == ownerName()
      );
    }

    function canAccess(data) {
      return isManager() || isMyData(data);
    }

    function saleKeepsOwnership() {
      return request.resource.data.ownerEmail == resource.data.ownerEmail &&
             request.resource.data.owner == resource.data.owner &&
             request.resource.data.createdByEmail == resource.data.createdByEmail;
    }

    function saleCustomerAllowedUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'phoneRaw', 'phoneNormalized', 'noPhone',
        'address', 'source', 'channel', 'customerType', 'companyName',
        'partnerType', 'partnerActivity', 'partnerLevel', 'partnerCapacity',
        'need', 'note', 'status', 'follow', 'nextCareDate', 'lastContactAt',
        'dealStatus', 'updatedAt', 'updatedByEmail'
      ]);
    }

    function customerHasMinimumData(data) {
      return data.name is string && data.name.size() > 0 &&
        (
          (data.phoneNormalized is string && data.phoneNormalized.size() > 0) ||
          data.noPhone == true
        );
    }

    function managerSoftDeleteOnly() {
      return isManager() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'deletedAt',
          'deletedByEmail',
          'updatedAt',
          'updatedByEmail'
        ]) &&
        request.resource.data.isDeleted == true &&
        request.resource.data.deletedByEmail == myEmail() &&
        request.resource.data.updatedByEmail == myEmail();
    }

    function userCreateAllowedFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'email', 'name', 'role', 'active', 'canExport', 'team', 'createdAt'
      ]);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();
      allow create: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          userCreateAllowedFieldsOnly() &&
          request.resource.data.email == myEmail() &&
          request.resource.data.role == 'sale' &&
          request.resource.data.active == false &&
          request.resource.data.canExport == false
        )
      );
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow get: if activeUser();
      allow list: if isManager();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isManager() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'careDueDays',
          'updatedByEmail',
          'updatedAt'
        ])
      );
    }

    match /kpiRules/{ruleId} {
      allow read: if activeUser();
      allow create, update, delete: if isManager();
    }

    match /kpiProposals/{proposalId} {
      allow read: if canAccess(resource.data);
      allow create: if activeUser() &&
        request.resource.data.kpiRuleId is string &&
        request.resource.data.month is string &&
        request.resource.data.ownerEmail == myEmail() &&
        request.resource.data.email == myEmail() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0;
      allow update: if (
        isManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewNote', 'reviewedByEmail', 'reviewedAt', 'updatedAt'
          ]) &&
          request.resource.data.status in ['approved', 'rejected']
      ) || (
        activeUser() &&
          (resource.data.ownerEmail == myEmail() || resource.data.email == myEmail()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isDeleted', 'deletedByEmail', 'deletedAt', 'updatedByEmail', 'updatedAt'
          ]) &&
          request.resource.data.isDeleted == true &&
          request.resource.data.deletedByEmail == myEmail() &&
          request.resource.data.updatedByEmail == myEmail()
      );
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if activeUser();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /userSessions/{userId} {
      allow read: if isAdmin();
      allow create, update: if activeUser() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if canAccess(resource.data);

      allow create: if customerHasMinimumData(request.resource.data) && (
        isManager() || (
          activeUser() &&
          request.resource.data.ownerEmail == myEmail() &&
          request.resource.data.createdByEmail == myEmail() &&
          request.resource.data.isDeleted == false
        )
      );

      allow update: if isManager() || (
        isMyData(resource.data) &&
        saleKeepsOwnership() &&
        saleCustomerAllowedUpdateOnly()
      );

      // Không xóa cứng khách từ webapp. App dùng soft delete bằng update isDeleted=true cho admin/manager.
      allow delete: if isAdmin();
    }

    match /careLogs/{logId} {
      allow read: if canAccess(resource.data);
      allow create: if canAccess(request.resource.data) && request.resource.data.customerId is string;
      allow update: if isAdmin() || managerSoftDeleteOnly();
      allow delete: if isAdmin();
    }

    match /deals/{dealId} {
      allow read: if canAccess(resource.data);
      allow create: if canAccess(request.resource.data) && request.resource.data.customerId is string;
      allow update: if isManager() || (
        isMyData(resource.data) &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.owner == resource.data.owner &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dealStatus', 'completed', 'completedAt', 'completedByEmail',
          'canceled', 'canceledAt', 'canceledByEmail',
          'updatedAt', 'updatedByEmail'
        ])
      );
      allow delete: if isAdmin();
    }

    match /phoneIndex/{phone} {
      // Cần đọc để transaction chống trùng SĐT. Doc này chỉ nên chứa customerId/owner/ownerEmail, không chứa thông tin nhạy cảm.
      allow get: if activeUser();
      allow list: if isManager();
      allow create: if activeUser() &&
        request.resource.data.customerId is string &&
        request.resource.data.owner is string &&
        (
          isManager() || request.resource.data.ownerEmail == myEmail()
        );
      allow update: if isManager() || (
        activeUser() &&
        resource.data.ownerEmail == myEmail() &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.ownerEmail == resource.data.ownerEmail
      );
      allow delete: if isManager() || (activeUser() && resource.data.ownerEmail == myEmail());
    }

    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if activeUser() && request.resource.data.email == myEmail();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
