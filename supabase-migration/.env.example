# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase project. Used with Google Application Default Credentials.
FIREBASE_PROJECT_ID=project-ffc49bd5-9852-4aa9-b6b

# Optional fallback if your Google Cloud org allows service account keys.
# GOOGLE_APPLICATION_CREDENTIALS=D:\secure\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional tuning
BATCH_SIZE=300

# Temporary password for creating Supabase Auth users from app_users.
# Users should change this after first login.
DEFAULT_USER_PASSWORD=ChangeMe@123456
